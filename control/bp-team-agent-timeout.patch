diff --git a/test/op-timeout.test.js b/test/op-timeout.test.js
new file mode 100644
index 0000000..d0f27b9
--- /dev/null
+++ b/test/op-timeout.test.js
@@ -0,0 +1,28 @@
+// Дневной прогон дважды, 17 и 18.09, убивало общим пределом 15 минут вместе с отчётом.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { OPS } from '../src/ops-linkedin.js';
+
+test('у дневного прогона свой срок, и он длиннее общего', () => {
+  assert.ok(OPS.daily.timeoutMin >= 30,
+    'дневной прогон — полтора десятка шагов подряд, в общий предел он не укладывается никогда');
+});
+
+test('свой срок только у длинных операций, остальные на общем', () => {
+  const своиСроки = Object.keys(OPS).filter((k) => OPS[k].timeoutMin);
+  assert.deepEqual(своиСроки, ['daily'],
+    'срок назначается осознанно, а не расставляется по всем операциям подряд');
+});
+
+test('общий предел поднимается переменной окружения, без правки кода', () => {
+  const src = readFileSync(new URL('../src/ops-linkedin.js', import.meta.url), 'utf8');
+  assert.match(src, /LINKEDIN_OP_TIMEOUT_MS/);
+  assert.equal(/timeoutMs = \d+ \* 60 \* 1000/.test(src), false,
+    'предел не должен стоять числом прямо в подписи функции');
+});
+
+test('запуск операции передаёт её собственный срок', () => {
+  const src = readFileSync(new URL('../scripts/runner.mjs', import.meta.url), 'utf8');
+  assert.match(src, /spec\.timeoutMin/);
+});
