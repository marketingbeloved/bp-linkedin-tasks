   // предпросмотр пропускается: лишний шаг на каждой мелочи — это затык,
   // а не безопасность.
-  const straight = /\b(сразу|без подтвержд|не спрашивай|не переспрашивай|просто сделай)\b/i.test(text);
+  // ⚠️ Без \b: в JavaScript \b это граница между [A-Za-z0-9_] и остальным, поэтому
+  // с русскими словами он не срабатывает НИКОГДА — проверено:
+  // /\bсразу\b/i.test('приглашения сразу') === false. Из-за этого выключатель
+  // подтверждения не работал, и отдел получал «Отправляем? да» на каждую команду.
+  const straight = /(сразу|без подтвержд|не спрашивай|не переспрашивай|просто сделай)/i.test(text);
 
   // ⛔ Для правки кода реплику модели НЕ показываем: разбор заявки ниже задаёт
   // своё подтверждение, и человек получал ДВА подряд — «подтверждаешь?» от
